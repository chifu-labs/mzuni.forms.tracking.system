# ─────────────────────────────────────────────────────────────────
# Mzuzu University DTS — Environment Configuration
# ─────────────────────────────────────────────────────────────────
# IMPORTANT: Never commit this file to version control.
# Add .env to your .gitignore file.

# Flask secret key — change this to a long random string in production
SECRET_KEY=

# Gmail account used to send all system emails
# Use an App Password (not your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# Database URI (SQLite for local; swap for PostgreSQL in production)
DATABASE_URL=
